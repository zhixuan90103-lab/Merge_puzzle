{
  "name": "merge-puzzle",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Merge Puzzle: same-color merge, push exile, mono full-board clear. TS + Vite + Capacitor iOS.",
  "scripts": {
    "dev": "vite --host --port 5200",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 5200",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "ios": "npm run cap:sync && npm run cap:open",
    "ios:bootstrap": "node scripts/bootstrap-ios.mjs",
    "validate:levels": "npx tsx scripts/validate-levels.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@types/three": "^0.178.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  }
}
